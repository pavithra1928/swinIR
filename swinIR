            "======================================================================\n",
            "import torch\n",
            "from torch.utils.data import Dataset\n",
            "import numpy as np\n",
            "import random\n",
            "\n",
            "\n",
            "class KLASwinIRDataset(Dataset):\n",
            "\n",
            "    def __init__(\n",
            "        self,\n",
            "        names,\n",
            "        gt_dict,\n",
            "        noisy_dict,\n",
            "        patch_size=48,\n",
            "        scale=2,\n",
            "        augment=False\n",
            "    ):\n",
            "\n",
            "        self.names = names\n",
            "        self.gt_dict = gt_dict\n",
            "        self.noisy_dict = noisy_dict\n",
            "        self.patch_size = patch_size\n",
            "        self.scale = scale\n",
            "        self.augment = augment\n",
            "\n",
            "    def __len__(self):\n",
            "\n",
            "        return len(self.names)\n",
            "\n",
            "    def __getitem__(self, index):\n",
            "\n",
            "        name = self.names[index]\n",
            "\n",
            "        # Ground-truth image\n",
            "        gt = self.gt_dict[name].astype(\n",
            "            np.float32\n",
            "        )\n",
            "\n",
            "        # Degraded/noisy image\n",
            "        noisy = self.noisy_dict[name].astype(\n",
            "            np.float32\n",
            "        )\n",
            "\n",
            "        # Convert to 2D if necessary\n",
            "        gt = np.squeeze(gt)\n",
            "        noisy = np.squeeze(noisy)\n",
            "\n",
            "        # ------------------------------------------------\n",
            "        # Normalize both images using their actual values\n",
            "        # ------------------------------------------------\n",
            "\n",
            "        gt_min = gt.min()\n",
            "        gt_max = gt.max()\n",
            "\n",
            "        if gt_max > gt_min:\n",
            "            gt = (\n",
            "                gt - gt_min\n",
            "            ) / (\n",
            "                gt_max - gt_min\n",
            "            )\n",
            "        else:\n",
            "            gt = np.zeros_like(gt)\n",
            "\n",
            "        noisy_min = noisy.min()\n",
            "        noisy_max = noisy.max()\n",
            "\n",
            "        if noisy_max > noisy_min:\n",
            "            noisy = (\n",
            "                noisy - noisy_min\n",
            "            ) / (\n",
            "                noisy_max - noisy_min\n",
            "            )\n",
            "        else:\n",
            "            noisy = np.zeros_like(noisy)\n",
            "\n",
            "        # ------------------------------------------------\n",
            "        # Make sure LQ is half the GT resolution\n",
            "        # ------------------------------------------------\n",
            "\n",
            "        expected_lq_h = gt.shape[0] // self.scale\n",
            "        expected_lq_w = gt.shape[1] // self.scale\n",
            "\n",
            "        if noisy.shape[0] != expected_lq_h or \\\n",
            "           noisy.shape[1] != expected_lq_w:\n",
            "\n",
            "            import cv2\n",
            "\n",
            "            noisy = cv2.resize(\n",
            "                noisy,\n",
            "                (\n",
            "                    expected_lq_w,\n",
            "                    expected_lq_h\n",
            "                ),\n",
            "                interpolation=cv2.INTER_AREA\n",
            "            )\n",
            "\n",
            "        # ------------------------------------------------\n",
            "        # Random crop\n",
            "        # ------------------------------------------------\n",
            "\n",
            "        lq_size = self.patch_size\n",
            "        gt_size = lq_size * self.scale\n",
            "\n",
            "        h, w = noisy.shape\n",
            "\n",
            "        if h < lq_size or w < lq_size:\n",
            "\n",
            "            import cv2\n",
            "\n",
            "            noisy = cv2.resize(\n",
            "                noisy,\n",
            "                (\n",
            "                    max(w, lq_size),\n",
            "                    max(h, lq_size)\n",
            "                ),\n",
            "                interpolation=cv2.INTER_AREA\n",
            "            )\n",
            "\n",
            "            h, w = noisy.shape\n",
            "\n",
            "        top = random.randint(\n",
            "            0,\n",
            "            h - lq_size\n",
            "        )\n",
            "\n",
            "        left = random.randint(\n",
            "            0,\n",
            "            w - lq_size\n",
            "        )\n",
            "\n",
            "        lq_patch = noisy[\n",
            "            top:top + lq_size,\n",
            "            left:left + lq_size\n",
            "        ]\n",
            "\n",
            "        gt_top = top * self.scale\n",
            "        gt_left = left * self.scale\n",
            "\n",
            "        gt_patch = gt[\n",
            "            gt_top:gt_top + gt_size,\n",
            "            gt_left:gt_left + gt_size\n",
            "        ]\n",
            "\n",
            "        # ------------------------------------------------\n",
            "        # Data augmentation\n",
            "        # ------------------------------------------------\n",
            "\n",
            "        if self.augment:\n",
            "\n",
            "            if random.random() < 0.5:\n",
            "\n",
            "                lq_patch = np.fliplr(\n",
            "                    lq_patch\n",
            "                ).copy()\n",
            "\n",
            "                gt_patch = np.fliplr(\n",
            "                    gt_patch\n",
            "                ).copy()\n",
            "\n",
            "            if random.random() < 0.5:\n",
            "\n",
            "                lq_patch = np.flipud(\n",
            "                    lq_patch\n",
            "                ).copy()\n",
            "\n",
            "                gt_patch = np.flipud(\n",
            "                    gt_patch\n",
            "                ).copy()\n",
            "\n",
            "            if random.random() < 0.5:\n",
            "\n",
            "                lq_patch = np.rot90(\n",
            "                    lq_patch\n",
            "                ).copy()\n",
            "\n",
            "                gt_patch = np.rot90(\n",
            "                    gt_patch\n",
            "                ).copy()\n",
            "\n",
            "        # ------------------------------------------------\n",
            "        # Convert NumPy → PyTorch\n",
            "        # ------------------------------------------------\n",
            "\n",
            "        lq_patch = torch.from_numpy(\n",
            "            lq_patch.copy()\n",
            "        ).float().unsqueeze(0)\n",
            "\n",
            "        gt_patch = torch.from_numpy(\n",
            "            gt_patch.copy()\n",
            "        ).float().unsqueeze(0)\n",
            "\n",
            "        return lq_patch, gt_patch\n",
            "\n",
            "\n",
            "print(\"KLASwinIRDataset class created successfully.\")\n",
            "\n",
