            "\n",
            "def calculate_psnr(pred, target):\n",
            "    \"\"\"\n",
            "    Calculate PSNR for images whose valid range is [0, 1].\n",
            "    \"\"\"\n",
            "\n",
            "    pred = torch.clamp(pred, 0.0, 1.0)\n",
            "\n",
            "    mse = torch.mean((pred - target) ** 2)\n",
            "\n",
            "    if mse.item() == 0:\n",
            "        return float(\"inf\")\n",
            "\n",
            "    psnr = 10 * torch.log10(1.0 / mse)\n",
            "\n",
            "    return psnr.item()\n",
            "\n",
            "\n",
            "def train_one_epoch(\n",
            "    model,\n",
            "    loader,\n",
            "    criterion,\n",
            "    optimizer,\n",
            "    device\n",
            "):\n",
            "\n",
            "    model.train()\n",
            "\n",
            "    running_loss = 0.0\n",
            "\n",
            "    for batch_idx, (lq, gt) in enumerate(loader):\n",
            "\n",
            "        lq = lq.to(\n",
            "            device,\n",
            "            non_blocking=True\n",
            "        )\n",
            "\n",
            "        gt = gt.to(\n",
            "            device,\n",
            "            non_blocking=True\n",
            "        )\n",
            "\n",
            "        optimizer.zero_grad(\n",
            "            set_to_none=True\n",
            "        )\n",
            "\n",
            "        output = model(lq)\n",
            "\n",
            "        loss = criterion(\n",
            "            output,\n",
            "            gt\n",
            "        )\n",
            "\n",
            "        loss.backward()\n",
            "\n",
            "        optimizer.step()\n",
            "\n",
            "        running_loss += loss.item()\n",
            "\n",
            "        if (batch_idx + 1) % 50 == 0:\n",
            "\n",
            "            print(\n",
            "                f\"  Batch {batch_idx + 1}/{len(loader)} \"\n",
            "                f\"Loss: {loss.item():.6f}\"\n",
            "            )\n",
            "\n",
            "    average_loss = (\n",
            "        running_loss / len(loader)\n",
            "    )\n",
            "\n",
            "    return average_loss\n",
            "\n",
            "\n",
            "@torch.no_grad()\n",
            "def validate(\n",
