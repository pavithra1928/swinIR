      "source": [
        "import os\n",
        "import numpy as np\n",
        "import torch\n",
        "from torch.utils.data import Dataset\n",
        "\n",
        "\n",
        "class KLASwinIRDataset(Dataset):\n",
        "\n",
        "    def __init__(self, names, gt_dir, noisy_dir):\n",
        "        self.names = names\n",
        "        self.gt_dir = gt_dir\n",
        "        self.noisy_dir = noisy_dir\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.names)\n",
        "\n",
        "    def __getitem__(self, index):\n",
        "\n",
        "        name = self.names[index]\n",
        "\n",
        "        # Load GT and NoisyLR\n",
        "        gt = np.load(\n",
        "            os.path.join(self.gt_dir, name)\n",
        "        )\n",
        "\n",
        "        noisy_lr = np.load(\n",
        "            os.path.join(self.noisy_dir, name)\n",
        "        )\n",
        "\n",
        "        # Convert NumPy arrays to float32\n",
        "        gt = gt.astype(np.float32)\n",
        "        noisy_lr = noisy_lr.astype(np.float32)\n",
        "\n",
        "        # Add channel dimension\n",
        "        # H,W -> 1,H,W\n",
        "        gt = np.expand_dims(gt, axis=0)\n",
        "        noisy_lr = np.expand_dims(noisy_lr, axis=0)\n",
        "\n",
        "        # Convert to PyTorch tensors\n",
        "        gt = torch.from_numpy(gt)\n",
        "        noisy_lr = torch.from_numpy(noisy_lr)\n",
        "\n",
        "        return noisy_lr, gt\n",
        "\n",
        "\n",
        "print(\"KLASwinIRDataset created successfully.\")"
      ]
    },
