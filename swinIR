        "import torch\n",
        "from torch.utils.data import Dataset\n",
        "import numpy as np\n",
        "import random\n",
        "\n",
        "\n",
        "class KLASwinIRDataset(Dataset):\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        names,\n",
        "        gt_dict,\n",
        "        noisy_dict,\n",
        "        patch_size=48,\n",
        "        scale=2,\n",
        "        augment=True\n",
        "    ):\n",
        "\n",
        "        self.names = names\n",
        "        self.gt_dict = gt_dict\n",
        "        self.noisy_dict = noisy_dict\n",
        "\n",
        "        self.patch_size = patch_size\n",
        "        self.scale = scale\n",
        "        self.augment = augment\n",
        "\n",
        "    def __len__(self):\n",
        "\n",
        "        return len(self.names)\n",
        "\n",
        "    def __getitem__(self, index):\n",
        "\n",
        "        filename = self.names[index]\n",
        "\n",
        "        # Load the paired .npy files\n",
        "        gt = np.load(\n",
        "            self.gt_dict[filename]\n",
        "        ).astype(\n",
        "            np.float32\n",
        "        )\n",
        "\n",
        "        noisy = np.load(\n",
        "            self.noisy_dict[filename]\n",
        "        ).astype(\n",
        "            np.float32\n",
        "        )\n",
        "\n",
        "        # ------------------------------------------------\n",
        "        # Input: 128x128\n",
        "        # Target: 256x256\n",
        "        # ------------------------------------------------\n",
        "\n",
        "        h, w = noisy.shape\n",
        "\n",
        "        p = self.patch_size\n",
        "\n",
        "        # Random crop position in the low-resolution image\n",
        "        y = random.randint(\n",
        "            0,\n",
        "            h - p\n",
        "        )\n",
        "\n",
        "        x = random.randint(\n",
        "            0,\n",
        "            w - p\n",
        "        )\n",
        "\n",
        "        # LQ patch\n",
        "        noisy_patch = noisy[\n",
        "            y:y+p,\n",
        "            x:x+p\n",
        "        ]\n",
        "\n",
        "        # Corresponding GT coordinates\n",
        "        gt_y = y * self.scale\n",
        "        gt_x = x * self.scale\n",
        "\n",
        "        gt_p = p * self.scale\n",
        "\n",
        "        # GT patch\n",
        "        gt_patch = gt[\n",
        "            gt_y:gt_y+gt_p,\n",
        "            gt_x:gt_x+gt_p\n",
        "        ]\n",
        "\n",
        "        # ------------------------------------------------\n",
        "        # Data augmentation\n",
        "        # ------------------------------------------------\n",
        "\n",
        "        if self.augment:\n",
        "\n",
        "            if random.random() < 0.5:\n",
        "\n",
        "                noisy_patch = np.fliplr(\n",
        "                    noisy_patch\n",
        "                ).copy()\n",
        "\n",
        "                gt_patch = np.fliplr(\n",
        "                    gt_patch\n",
        "                ).copy()\n",
        "\n",
        "            if random.random() < 0.5:\n",
        "\n",
        "                noisy_patch = np.flipud(\n",
        "                    noisy_patch\n",
        "                ).copy()\n",
        "\n",
        "                gt_patch = np.flipud(\n",
        "                    gt_patch\n",
        "                ).copy()\n",
        "\n",
        "            if random.random() < 0.5:\n",
        "\n",
        "                noisy_patch = np.rot90(\n",
        "                    noisy_patch\n",
        "                ).copy()\n",
        "\n",
        "                gt_patch = np.rot90(\n",
        "                    gt_patch\n",
        "                ).copy()\n",
        "\n",
        "        # ------------------------------------------------\n",
        "        # Convert numpy -> PyTorch\n",
        "        # ------------------------------------------------\n",
        "\n",
        "        noisy_patch = torch.from_numpy(\n",
        "            noisy_patch\n",
        "        ).float()\n",
        "\n",
        "        gt_patch = torch.from_numpy(\n",
        "            gt_patch\n",
        "        ).float()\n",
        "\n",
        "        # Add channel dimension\n",
        "        # [H,W] -> [1,H,W]\n",
        "\n",
        "        noisy_patch = noisy_patch.unsqueeze(0)\n",
        "\n",
        "        gt_patch = gt_patch.unsqueeze(0)\n",
        "\n",
        "        return noisy_patch, gt_patch\n",
        "\n",
        "\n",
        "print(\"KLA Dataset class created successfully.\")"
      ]
